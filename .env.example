# Adresse publique derrière un proxy. Les accès directs locaux sont reconnus automatiquement.
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Mettre 1 uniquement derrière un reverse proxy de confiance qui remplace X-Forwarded-For.
TRUST_PROXY=0
NEXT_TELEMETRY_DISABLED=1

# Optional notifications; disabled until explicitly enabled in the account settings.
# NTFY_URL=https://ntfy.example.org/private-topic
# NTFY_TOKEN=
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_FROM=ouicheur@example.org
# SMTP_USER=ouicheur@example.org
# SMTP_PASSWORD=
# SMTP_TO=owner@example.org
